# Client BFF: backend-for-frontend личного кабинета клиента.
# Держит client-сессию (Telegram Login → client-JWT), ходит в API по X-Internal-Key.
# Верификация подписи Telegram Login Widget — в api (там токены ботов): BFF секретов не держит.
PORT=3005

# Подпись client-JWT (access + refresh). Сгенерируйте длинный случайный секрет.
CLIENT_JWT_SECRET=change-me-to-a-random-secret
CLIENT_JWT_ACCESS_TTL=15m
CLIENT_JWT_REFRESH_TTL=30d

# API connection (единственный владелец БД/биллинга)
API_BASE_URL=http://localhost:3001/api
API_INTERNAL_KEY=change-me-to-a-random-key

# CORS: origin кабинета (client-web). При прокси через client-web CORS не требуется,
# но оставлено для прямых вызовов BFF.
CLIENT_WEB_ORIGIN=http://localhost:3006
