# Менеджерский бот: уведомления о входящих, чат с клиентом, запуск расчёта.
# Токены ботов задаются per-company в админке (Компании → боты) и грузятся из GET /internal/bots,
# не через env. См. docs/COMPANY_BOTS.md.
BOT_PORT=3004

# API connection
API_BASE_URL=http://localhost:3001/api
API_INTERNAL_KEY=change-me-to-a-random-key

# Redis (активный диалог менеджера + BullMQ manager-notifications)
REDIS_URL=redis://localhost:6380

# База админки для deep-link кнопок «Открыть в админке»
ADMIN_WEB_BASE_URL=http://localhost:3000
