# Личный кабинет клиента (Next.js). Браузер ходит в свой /api/*, который проксируется в BFF.

# Username бота, к которому привязан Telegram Login Widget (client-bot), без @.
# Домен кабинета должен быть прописан боту: @BotFather → /setdomain.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=direct_port_bot

# Адрес client-bff для серверного прокси /api/[...path] (server-side, не публичный).
CLIENT_BFF_URL=http://localhost:3005

# Реквизиты для offline-оплаты заявок на пополнение (многострочный текст). Показываются
# в кабинете после оформления заявки. Пусто — показывается только инструкция без реквизитов.
NEXT_PUBLIC_PAYMENT_DETAILS=
