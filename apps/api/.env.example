# API server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Postgres
DATABASE_URL=postgresql://directport:directport@localhost:5434/directport

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6380

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_EXPIRATION=15m

# Internal API key (service-to-service: bot -> API)
API_INTERNAL_KEY=change-me-to-a-random-key

# Ключ шифрования токенов Telegram-ботов компаний (AES-256-GCM, см. docs/COMPANY_BOTS.md).
# Произвольная секретная строка; приводится к 32 байтам через SHA-256. Без него заведение
# ботов компаний в админке недоступно (токены не шифруются). В проде — из Vault/ESO.
BOT_TOKEN_ENC_KEY=change-me-to-a-random-secret

# Username менеджерского бота (без @) — нужен для deep-link привязки Telegram
# менеджера в админке (manager-link.service.ts). Без него кнопка привязки
# покажет «Бот не настроен».
MANAGER_BOT_USERNAME=

# Верификация подписи Telegram Login Widget в кабинете (TelegramVerifyService): логин работает
# только для компаний со своим client-ботом (токен из БД по slug); служебная дефолтная компания
# входа не имеет (env-токен бота удалён, см. docs/COMPANY_BOTS.md).
# Максимальный возраст auth_date Telegram-логина в секундах (анти-replay), по умолчанию 86400.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# TKS API (api1.tks.ru)
TKS_API_BASE_URL=https://api1.tks.ru
TKS_TNVED_API_KEY=
TKS_GOODS_API_KEY=
# TTL кэша ответов TKS API в миллисекундах (по умолчанию 24 часа)
TKS_CACHE_TTL_MS=86400000

# Anthropic Claude (optional, for ТН ВЭД verification)
ANTHROPIC_API_KEY=

# Максимальное число товарных позиций (строк таблицы) в загружаемом файле.
# При превышении файл отклоняется с понятным сообщением пользователю. По умолчанию 700.
MAX_PRODUCT_ROWS_PER_FILE=700

# Ретеншен аудит-таблиц pipeline (PipelineAuditRetentionService):
# ai_call + pipeline_stage_run хранятся N дней (по умолчанию 90),
# document_version — M дней (по умолчанию 180). Старше — удаляются фоновой очисткой.
PIPELINE_AUDIT_RETENTION_DAYS=90
DOCUMENT_VERSION_RETENTION_DAYS=180

# Приветственный бонус нового клиента в позициях (welcome-grant при регистрации).
# Пусто — дефолт из пакета free (50). 0 — выключить.
WELCOME_GRANT_POSITIONS=

# Лимит self-service загрузок из кабинета на аккаунт в час (fixed window в Redis).
# Пусто — дефолт 10. 0 — выключить лимит.
CABINET_UPLOAD_HOURLY_LIMIT=
